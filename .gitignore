# Node
node_modules/
npm-debug.log*
.npm/

# Tooling caches
.cache/
.biome-cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local workspace manifest (each user copies the .example and edits it locally;
# the real one points at their private on-disk bundle checkouts)
/workspace.okf.yaml

# OpenCode agent session/continuation state — machine cruft, not repo content
.omo/

# The journal, when a developer places a copy beside the skill so the skill's
# own "the journal is running on this machine" branch is reachable while working
# on it (see CONTRIBUTING.md). It used to be a committed symlink, which a Windows
# clone turns into a text file holding the path; the copy is local and untracked.
/skills/*/JOURNAL.md
